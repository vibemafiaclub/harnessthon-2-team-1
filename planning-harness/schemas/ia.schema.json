{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ia.yaml",
  "type": "object",
  "required": ["entities", "screens"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": { "project": { "type": "string" }, "updated": { "type": "string" } }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "fields"],
        "properties": {
          "id": { "type": "string", "pattern": "^ENT-\\d{2,3}$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "owner": { "type": "string", "pattern": "^ROLE-\\d{2,3}$" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type", "required"],
              "properties": {
                "name": { "type": "string" },
                "type": { "enum": ["string", "number", "date", "datetime", "enum", "ref", "bool"] },
                "required": { "type": "boolean" },
                "note": { "type": "string" }
              }
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["to", "type"],
              "properties": {
                "to": { "type": "string", "pattern": "^ENT-\\d{2,3}$" },
                "type": { "enum": ["1:1", "1:N", "N:M"] },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose", "roles", "requirements", "key_info", "states"],
        "properties": {
          "id": { "type": "string", "pattern": "^SCR-\\d{2,3}(\\.\\d+)?$" },
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "roles": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "pattern": "^ROLE-\\d{2,3}$" }
          },
          "entities": { "type": "array", "items": { "type": "string", "pattern": "^ENT-\\d{2,3}$" } },
          "requirements": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "pattern": "^REQ-\\d{2,3}$" }
          },
          "entry_points": { "type": "array", "items": { "type": "string" } },
          "key_info": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "actions": { "type": "array", "items": { "type": "string" } },
          "states": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "description"],
              "properties": {
                "type": { "enum": ["empty", "loading", "error", "partial", "no-permission", "large-dataset"] },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "navigation": { "type": "object" }
  }
}
